{
  "name": "tl",
  "version": "0.0.0",
  "private": true,
  "description": "Machine Learning in TypeScript with hand-written math and an API that guides you through the ML workflow",
  "keywords": [
    "machine-learning",
    "ml",
    "typescript",
    "pipeline",
    "time-series",
    "regression",
    "classification"
  ],
  "author": "Tobias Cadoná Marion <tobiascm87@gmail.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tobiasMarion/tl.git"
  },
  "homepage": "https://github.com/tobiasMarion/tl#readme",
  "bugs": {
    "url": "https://github.com/tobiasMarion/tl/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "example": "node examples/penguins/index.ts",
    "example:bad": "node examples/penguins/index.ts --bad",
    "example:air-passengers": "node examples/air-passengers/index.ts",
    "example:scikit-learn": "uv run --project examples/scikit-learn examples/scikit-learn/penguins.py",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prebuild": "npm run clean",
    "prepack": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
